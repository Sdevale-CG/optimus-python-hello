{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "optimus-python-app",
      "image": "137360334857.dkr.ecr.us-west-2.amazonaws.com/optimus-python-hello:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "APP_VERSION",
          "value": "1.0"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/elasticbeanstalk/optimus-python-app",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "optimus"
        }
      }
    }
  ]
}